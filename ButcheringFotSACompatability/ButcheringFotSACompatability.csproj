<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>bin/$(Configuration)/Build</OutputPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">F:/Games/VintageStory/Server/1.22.7</VintageStoryPath>
    <DevelopmentModDirectory>$(MSBuildProjectDirectory)/bin/$(Configuration)/Mods/mod</DevelopmentModDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStoryPath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintageStoryPath)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <DevelopmentModFile Include="$(MSBuildProjectDirectory)/modinfo.json" />
    <DevelopmentModFile Include="$(MSBuildProjectDirectory)/modicon.png" Condition="Exists('$(MSBuildProjectDirectory)/modicon.png')" />
  </ItemGroup>

  <Target Name="StageDevelopmentCodeMod" AfterTargets="Build">
    <RemoveDir Directories="$(DevelopmentModDirectory)" />
    <MakeDir Directories="$(DevelopmentModDirectory)" />
    <Copy SourceFiles="@(DevelopmentModFile)" DestinationFolder="$(DevelopmentModDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevelopmentModDirectory)" />
    <ItemGroup>
      <DevelopmentAsset Include="$(MSBuildProjectDirectory)/assets/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DevelopmentAsset)" DestinationFiles="@(DevelopmentAsset->'$(DevelopmentModDirectory)/assets/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
